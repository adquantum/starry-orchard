# Starry Orchard / wiz101 - collaborative Godot 4.5+ source repository.
# Keep runtime assets, scenes, resources, addons, tools and tests by default.
# Keep source-side *.import and *.uid files; never ignore them globally.
# This file does NOT delete local files or remove files already tracked by Git.

# Local build/export products (keep export_presets.cfg and build scripts).
/build/
/builds/
/dist/
/releases/
/output/
/android/
/*.pck
/*.exe
/*.apk
/*.aab

# Local archives, review exports and assistant working state.
/backups/
/.legacy_archive/
/previews/
/logs/
/tmp/
/.tmp
/.agents/
/.workbuddy/
/.learnings/

# Raw art is optional; retain conversion code, manifests and documentation.
/art_source/**
!/art_source/**/
!/art_source/**/*.py
!/art_source/**/*.ps1
!/art_source/**/*.sh
!/art_source/**/*.cmd
!/art_source/**/*.bat
!/art_source/**/*.json
!/art_source/**/*.csv
!/art_source/**/*.md
!/art_source/**/requirements*.txt
!/art_source/**/LICENSE*
!/art_source/**/NOTICE*
!/art_source/**/.gdignore
/art_source/**/vendor/
/art_source/skill-validation*/
/art_source/backups/
/art_source/world_one_backup/

# Documentation remains; discard rendered screenshots and review media.
/docs/**/*.png*
/docs/**/*.jpg*
/docs/**/*.jpeg*
/docs/**/*.webp*
/docs/**/*.gif*
/docs/**/*.mp4
/docs/**/*.webm
/docs/**/*.wav
/docs/**/*.mp3
/docs/**/*.ogg
/docs/**/*.zip
/docs/**/*.7z

