/tests/**/tmp/
/tests/**/artifacts/
/tests/weekend/04/user_contract/
/tests/weekend/04/user_walk/
/tests/**/*.png*
/tests/**/*.jpg*
/tests/**/*.gif*
/tests/**/*.mp4
/tests/**/*.webm
