/sts2.dll
/no_pvp_client_deck.json
/no_pvp_deck.json
/profile_absent.json
/tools/spell_audit/preview.png*
/tools/spell_audit/test-export.json

# Runtime assets are intentionally NOT reduced by static reachability:
# maps, monsters, wardrobe and cards also load assets dynamically.
# Git LFS is recommended for the retained large binary asset collection.

