!/tests/**/golden/**

# Personal runtime data; the server creates its own data directory.
/server/data/
/.appdata/
/.godot_user/
/.godot_test_userdata/
/server/**/accounts.sqlite*
/server/**/progression.sqlite*

# Local environment files and signing credentials; examples stay shareable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx
*.key
id_rsa
id_ed25519
/secrets/
/credentials/

# Regenerable caches, anywhere in the project. Keep lockfiles and manifests.
.godot/
.import/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
.cache/
.coverage
htmlcov/
*.log
